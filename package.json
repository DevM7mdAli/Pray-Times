{
  "name": "pray-times",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev:landing": "pnpm --filter @pray-times/landing-page dev",
    "dev:extension": "pnpm --filter @pray-times/extension dev",
    "build": "pnpm build:core && pnpm build:extension && pnpm build:landing",
    "build:core": "pnpm --filter @pray-times/core build",
    "build:extension": "pnpm --filter @pray-times/extension build",
    "build:landing": "pnpm --filter @pray-times/landing-page build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commitlint": "commitlint --last --verbose",
    "test": "pnpm -r test",
    "prepare": "husky",
    "verify:release": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "package:extension": "pnpm build:extension && node --import tsx tooling/extension/package.ts",
    "lint:firefox": "web-ext lint --source-dir apps/extension/dist/firefox --no-config-discovery",
    "check": "pnpm verify:release && pnpm package:extension && pnpm lint:firefox",
    "release": "semantic-release"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings=0"
    ],
    "*.{cjs,mjs,css,html,json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.36.0",
    "@fontsource/alexandria": "^5.3.0",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^22.17.2",
    "eslint": "^9.36.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.8",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "web-ext": "^10.5.0"
  }
}
