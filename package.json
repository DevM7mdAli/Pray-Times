{
  "name": "pray-times",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev:landing": "nx dev @pray-times/landing-page",
    "dev:extension": "nx dev @pray-times/extension",
    "dev:mobile": "pnpm --filter @pray-times/mobile start",
    "build": "nx run-many -t build",
    "build:core": "nx build @pray-times/core",
    "build:extension": "nx build @pray-times/extension",
    "build:landing": "nx build @pray-times/landing-page",
    "mobile:android": "pnpm --filter @pray-times/mobile android",
    "mobile:ios": "pnpm --filter @pray-times/mobile ios",
    "mobile:release": "pnpm --filter @pray-times/mobile release",
    "mobile:release:android": "pnpm --filter @pray-times/mobile release:android",
    "mobile:release:ios": "pnpm --filter @pray-times/mobile release:ios",
    "check:tailwind": "nx check-tailwind @pray-times/tooling",
    "typecheck": "nx run-many -t typecheck",
    "lint": "nx run-many -t lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commitlint": "commitlint --last --verbose",
    "test": "nx run-many -t test",
    "affected": "nx affected -t check-tailwind typecheck lint test build",
    "graph": "nx graph",
    "prepare": "husky",
    "verify:release": "pnpm format:check && nx run-many -t check-tailwind typecheck lint test build",
    "package:extension": "nx package @pray-times/extension",
    "lint:firefox": "nx lint-firefox @pray-times/extension",
    "check": "pnpm format:check && nx run-many -t check-tailwind typecheck lint test build package lint-firefox",
    "release": "semantic-release"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings=0"
    ],
    "*.{cjs,mjs,css,html,json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.36.0",
    "@fontsource/alexandria": "^5.3.0",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@nx/devkit": "24.0.0",
    "@nx/eslint": "24.0.0",
    "@nx/eslint-plugin": "24.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^22.17.2",
    "chrome-webstore-upload-cli": "^4.0.2",
    "eslint": "^9.36.0",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "nx": "24.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "semantic-release": "^25.0.8",
    "tailwindcss": "3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "web-ext": "^10.5.0"
  }
}
